{
  "name": "runlet",
  "version": "1.0.0",
  "private": true,
  "description": "Runlet — desktop HTML/CSS/JS playground on Electron with a Python code-analysis engine",
  "main": "electron/main.cjs",
  "license": "Apache-2.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "start": "npm run build && electron .",
    "dev": "npm run build && node scripts/serve.mjs",
    "web": "node scripts/serve.mjs",
    "analyze": "python3 analysis/engine.py",
    "test": "node scripts/test.mjs",
    "cli": "node cli/runlet.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/language": "^6.11.0",
    "@codemirror/lint": "^6.8.4",
    "@codemirror/search": "^6.5.8",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@lezer/highlight": "^1.2.1",
    "acorn": "^8.14.1",
    "fflate": "^0.8.2",
    "js-beautify": "^1.15.1"
  },
  "build": {
    "appId": "ai.runlet.editor",
    "productName": "Runlet",
    "files": [
      "electron/**/*",
      "app/**/*",
      "analysis/**/*",
      "public/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "analysis",
        "to": "analysis"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ]
    },
    "mac": {
      "target": "dmg"
    }
  },
  "optionalDependencies": {
    "electron": "^45.0.0"
  }
}